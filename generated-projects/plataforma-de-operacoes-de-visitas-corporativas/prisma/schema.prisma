generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum VisitRecurringHistoryPeriodRangeEnum {
  ultimos_3_meses
  ultimos_6_meses
  ultimos_12_meses
}
enum VisitRecurringHistoryVisitStatusEnum {
  realizada
  concluida
}
model VisitRecurringHistory {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  clientIdentifier String
  periodRange String
  visitStatus String
  status    String   @default("draft") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
}
model VisitExtraCompanion {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  approvedVisitCode String
  companionName String
  securityFastApproval String
  status    String   @default("draft") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
}
model VisitOperationalResponsible {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  responsibleName String
  contact String
  supportType String
  status    String   @default("draft") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
}
model EventSchedule {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  stageName String
  plannedDeadline String
  executionNotes String
  status    String   @default("draft") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
}