generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum VisitRecurringHistoryPeriodRangeEnum {
  ultimos_3_meses
  ultimos_6_meses
  ultimos_12_meses
}
enum VisitRecurringHistoryVisitStatusEnum {
  realizada
  concluida
}
model VisitRecurringHistory {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  clientIdentifier String @db.VarChar(191)
  periodRange String @db.VarChar(191)
  visitStatus String @db.VarChar(191)
  status    String   @default("draft") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
}
model VisitApprovalCutoffSetting {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  status    String   @default("draft") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
}
model VisitExtraCompanion {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  approvedVisitCode String @db.VarChar(191)
  companionName String @db.VarChar(191)
  securityFastApproval String @db.VarChar(191)
  status    String   @default("draft") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
}
model VisitOperationalResponsible {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  responsibleName String @db.VarChar(191)
  contact String @db.VarChar(191)
  supportType String @db.VarChar(191)
  status    String   @default("draft") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
}
model InitialVisitRequest {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  status    String   @default("draft") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
}
enum VisitOperationalResponsibleSupportTypeEnum {
  tecnico
  logistica
  seguranca
  apoio
}
enum VisitExtraCompanionSecurityFastApprovalEnum {
  pendente
  aprovado
}