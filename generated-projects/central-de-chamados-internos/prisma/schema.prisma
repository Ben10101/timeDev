generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum SupportTicketAttachmentDocumentTypeEnum {
  nota_fiscal
  comprovante
  recibo
  contrato
  outro
}
model SupportTicketAttachment {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  documentType String @db.VarChar(191)
  documentDescription String @db.Text
  fileUrl String @db.VarChar(500)
  status    String   @default("draft") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
}
model AccessControlRole {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  roleName String @db.VarChar(191)
  permissionMatrix String @db.VarChar(191)
  accessScope String @db.VarChar(191)
  status    String   @default("draft") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
}
model SupportPerformanceDashboard {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  categoryFilter String @db.VarChar(191)
  statusFilter String @db.VarChar(191)
  timeRange String @db.VarChar(191)
  status    String   @default("draft") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
}
model TicketNotificationPreference {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  notificationEmail String @db.VarChar(191)
  ticketUpdateAlerts String @db.VarChar(191)
  status    String   @default("draft") @db.VarChar(40)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
}

model TicketEscalationQueue {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  ticketId         String   @db.VarChar(191)
  escalationReason String   @db.Text
  targetTeam       String   @db.VarChar(191)
  urgencyLevel     String   @db.VarChar(191)
  status           String   @default("draft") @db.VarChar(40)
  createdAt        DateTime @default(now()) @db.DateTime(0)
  updatedAt        DateTime @updatedAt @db.DateTime(0)
}
